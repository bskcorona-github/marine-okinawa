{
  "name": "marine-okinawa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d",
    "seed": "tsx --import ./scripts/load-env.ts scripts/seed.ts",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/lib/auth.ts --output .tmp/auth-schema.ts --yes",
    "seed:sample": "tsx --import ./scripts/load-env.ts scripts/seed-sample.ts",
    "seed:demo": "tsx --import ./scripts/load-env.ts scripts/seed-demo.ts",
    "clear:demo": "tsx --import ./scripts/load-env.ts scripts/clear-demo.ts",
    "import:ginowan": "tsx --import ./scripts/load-env.ts scripts/import-ginowan.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.6",
    "budoux": "^0.9.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "otplib": "^13.5.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
