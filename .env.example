# Neon の pooled 接続文字列（-pooler 付きホスト）。OS の DATABASE_URL と衝突しないよう専用の名前にしている
MARINE_DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/marine?sslmode=verify-full
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# resend | log（log はコンソール出力のみ）
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=Marine Okinawa <noreply@example.com>
CRON_SECRET=replace-with-16-or-more-random-characters
# カード決済（Stripe）。空のあいだは「支払方法の案内」（振込先など）で受け付ける。本番は組合名義のアカウントの鍵
STRIPE_SECRET_KEY=
# Stripe の Webhook の署名の秘密鍵（whsec_…）。送り先は https://<本番の URL>/api/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Google・LINE でのログイン（任意。鍵がそろったものだけログインの画面に出す）。
# 戻り先（リダイレクト URI）は https://<本番の URL>/api/auth/callback/google と …/callback/line（開発は http://localhost:3000/…）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LINE Developers の LINE ログインのチャネル ID とチャネルシークレット（メールアドレスの取得の申請は要らない）
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
# 資料・写真の保存先。本番（Vercel）は Vercel Blob の非公開のストアの鍵（ストアを作ると自動で入る）
BLOB_READ_WRITE_TOKEN=
# 鍵がないとき（開発）の保存先のディレクトリ（既定 .storage）
STORAGE_DIR=.storage
# scripts/seed.ts 用
SEED_SHOP_NAME=沖縄マリンアクティビティ
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please-12chars
